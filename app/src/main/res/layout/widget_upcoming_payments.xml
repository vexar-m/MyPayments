<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ic_launcher_background"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Мои Платежи — Ближайшие"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Content Items Container -->
    <LinearLayout
        android:id="@+id/widget_items_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Item 1 -->
        <LinearLayout
            android:id="@+id/item1_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/item1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item1_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/item1_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#469EA2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 2 -->
        <LinearLayout
            android:id="@+id/item2_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/item2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item2_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/item2_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#469EA2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Item 3 -->
        <LinearLayout
            android:id="@+id/item3_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/item3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item3_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/item3_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#469EA2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Нет ближайших платежей"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            android:paddingVertical="8dp" />

    </LinearLayout>
</LinearLayout>